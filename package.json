{
    "name": "cuddle-lamp",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "start": "react-native start",
        "ios": "react-native run-ios",
        "core:ios": "bash scripts/build-core-ios.sh",
        "lint": "eslint .",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "prettier": "prettier . --check",
        "prettier:fix": "prettier . --write"
    },
    "dependencies": {
        "react": "19.2.3",
        "react-native": "0.87.1"
    },
    "devDependencies": {
        "@babel/core": "7.29.7",
        "@babel/runtime": "7.29.7",
        "@react-native-community/cli": "20.2.0",
        "@react-native-community/cli-platform-ios": "20.2.0",
        "@react-native/babel-preset": "0.87.1",
        "@react-native/eslint-config": "0.87.1",
        "@react-native/jest-preset": "0.87.1",
        "@react-native/metro-config": "0.87.1",
        "@types/jest": "29.5.9",
        "@types/react": "19.2.0",
        "eslint": "9.39.5",
        "jest": "29.7.0",
        "prettier": "3.8.1",
        "react-test-renderer": "19.2.3",
        "typescript": "6.0.3"
    },
    "engines": {
        "node": ">=22.11.0"
    },
    "codegenConfig": {
        "name": "CuddleLampSpecs",
        "type": "modules",
        "jsSrcsDir": "src/native/specs",
        "ios": {
            "modulesProvider": {
                "NativeSoundEngine": "SoundEngineModuleProvider"
            }
        }
    }
}
