{
    "id": "relax",
    "name": "Отдых",
    "seed": 2,
    "harmony": {
        "root": 60,
        "scale": [0, 2, 4, 7, 9],
        "chords": [
            [0, 7, 11, 16],
            [-3, 4, 7, 12],
            [-7, 4, 9, 12],
            [2, 9, 12, 17]
